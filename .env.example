# Django Restaurant POS & Management System - Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Security
SECRET_KEY=generate-a-strong-random-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app

# Database (Leave blank to use local SQLite, or provide PostgreSQL URL for production)
# DATABASE_URL=postgres://username:password@hostname:5432/databasename
